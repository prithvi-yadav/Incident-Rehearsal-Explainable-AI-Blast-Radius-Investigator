# Copy this file to .env for local development and replace placeholders.
GEMINI_API_KEY=your-gemini-api-key-here

# FalkorDB defaults to the local Docker instance when these are omitted.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH_NAME=incident_investigator

# For a hosted instance, prefer a falkor:// or falkors:// URL instead.
# FALKORDB_URL=falkors://username:password@example.com:6379
# FALKORDB_USERNAME=your-falkordb-username
# FALKORDB_PASSWORD=your-falkordb-password
# FALKORDB_SSL=true
# FALKORDB_SSL_CERT_REQS=required
# FALKORDB_SSL_CA_CERTS=C:\path\to\ca-bundle.pem
# FALKORDB_SSL_CA_PATH=C:\path\to\ca-directory
# FALKORDB_SSL_CA_DATA=your-ca-certificate-data
# FALKORDB_SSL_CERTFILE=C:\path\to\client-cert.pem
# FALKORDB_SSL_KEYFILE=C:\path\to\client-key.pem
# FALKORDB_SSL_PASSWORD=your-client-key-password
# FALKORDB_SSL_CHECK_HOSTNAME=true
# FALKORDB_SSL_VALIDATE_OCSP=false
# FALKORDB_SSL_VALIDATE_OCSP_STAPLED=false
# FALKORDB_SSL_OCSP_EXPECTED_CERT=your-expected-ocsp-certificate
